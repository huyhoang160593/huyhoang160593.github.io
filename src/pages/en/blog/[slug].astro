---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getAllPosts,
  findTranslation,
  getPosts,
  postSlug,
} from "../../../lib/posts";
import { formatDate, localizePath, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getPosts("en");
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = "en" as const;
const t = useTranslations(lang);
const { Content } = await render(post);

const counterpart = findTranslation(post, await getAllPosts());
const alternate = localizePath(
  counterpart ? `/blog/${postSlug(counterpart)}` : "/blog",
  "vi",
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  alternate={alternate}
>
  <article>
    <h1 class="text-3xl font-bold tracking-tight">{post.data.title}</h1>
    <p class="mt-3 text-sm text-base-content/60">
      <time datetime={post.data.pubDate.toISOString()}>
        {t("blog.publishedOn")} {formatDate(post.data.pubDate, lang)}
      </time>
      {post.data.updatedDate && (
        <span class="ms-3">
          {t("blog.updatedOn")} {formatDate(post.data.updatedDate, lang)}
        </span>
      )}
      {post.data.draft && (
        <span class="badge badge-warning badge-sm ms-2">{t("blog.draft")}</span>
      )}
    </p>

    {post.data.tags.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="badge badge-ghost badge-sm">{tag}</span>
        ))}
      </p>
    )}

    <div class="article mt-8">
      <Content />
    </div>
  </article>

  <p class="mt-12">
    <a href={localizePath("/blog", lang)} class="link link-hover">
      {t("blog.backToBlog")}
    </a>
  </p>
</BaseLayout>
