---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import TitleCard from "../../components/TitleCard.astro";
import { getPosts } from "../../lib/posts";
import { localizePath, useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, 5);
---

<BaseLayout title={t("site.name")} description={t("site.tagline")}>
  <TitleCard
    eyebrow={t("home.greeting")}
    title={t("site.name")}
    description={t("home.intro")}
  />

  {posts.length > 0 && (
    <section class="mt-10">
      <h2 class="font-display text-xl font-semibold">{t("home.latest")}</h2>
      <div class="mt-4 grid gap-5">
        {posts.map((post) => (
          <PostCard post={post} lang={lang} />
        ))}
      </div>
      <p class="mt-6">
        <a href={localizePath("/blog", lang)} class="contour-btn">
          {t("home.all")}
        </a>
      </p>
    </section>
  )}
</BaseLayout>
