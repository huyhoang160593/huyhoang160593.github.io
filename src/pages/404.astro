---
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleCard from "../components/TitleCard.astro";
import { localizePath, useTranslations } from "../i18n/utils";

const lang = "vi" as const;
const t = useTranslations(lang);
---

<BaseLayout title={t("notfound.title")} description={t("notfound.description")}>
  <TitleCard
    eyebrow={t("site.name")}
    title={t("notfound.title")}
    description={t("notfound.description")}
  />

  <p class="mt-8">
    <a href={localizePath("/", lang)} class="contour-btn">
      {t("notfound.backHome")}
    </a>
  </p>
</BaseLayout>
