---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import TitleCard from "../../components/TitleCard.astro";
import { getPosts, pageCount } from "../../lib/posts";
import { localizePath, useTranslations } from "../../i18n/utils";

const lang = "vi" as const;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const lastPage = pageCount(posts.length);
---

<BaseLayout title={t("blog.title")} description={t("blog.description")}>
  <TitleCard
    eyebrow={t("nav.blog")}
    title={t("blog.title")}
    description={t("blog.description")}
  >
    <a slot="action" href={localizePath("/rss.xml", lang)} class="contour-btn">
      {t("blog.rss")}
    </a>
  </TitleCard>

  {posts.length === 0 ? (
    <p class="mt-8">{t("blog.empty")}</p>
  ) : (
    <div class="mt-8 grid gap-5">
      {posts.slice(0, 10).map((post) => (
        <PostCard post={post} lang={lang} />
      ))}
    </div>
  )}

  <Pagination currentPage={1} lastPage={lastPage} lang={lang} />
</BaseLayout>
