---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getPosts, pageCount } from "../../lib/posts";
import { localizePath, useTranslations } from "../../i18n/utils";

const lang = "vi" as const;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const lastPage = pageCount(posts.length);
---

<BaseLayout title={t("blog.title")} description={t("blog.description")}>
  <header class="flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t("blog.title")}</h1>
      <p class="mt-2 text-base-content/60">{t("blog.description")}</p>
    </div>
    <a href={localizePath("/rss.xml", lang)} class="btn btn-ghost btn-sm">
      {t("blog.rss")}
    </a>
  </header>

  {posts.length === 0 ? (
    <p class="mt-8 text-base-content/60">{t("blog.empty")}</p>
  ) : (
    <div class="mt-8 grid gap-4">
      {posts.slice(0, 10).map((post) => (
        <PostCard post={post} lang={lang} />
      ))}
    </div>
  )}

  <Pagination currentPage={1} lastPage={lastPage} lang={lang} />
</BaseLayout>
