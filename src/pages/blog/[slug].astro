---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitleCard from "../../components/TitleCard.astro";
import {
  getAllPosts,
  findTranslation,
  getPosts,
  postSlug,
} from "../../lib/posts";
import {
  formatDate,
  formatEpisodeEyebrow,
  localizePath,
  useTranslations,
} from "../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getPosts("vi");
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = "vi" as const;
const t = useTranslations(lang);
const { Content } = await render(post);

const counterpart = findTranslation(post, await getAllPosts());
const alternate = localizePath(
  counterpart ? `/blog/${postSlug(counterpart)}` : "/blog",
  "en",
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  alternate={alternate}
>
  <article>
    <TitleCard
      eyebrow={formatEpisodeEyebrow(post.data.pubDate, lang, post.data.episode)}
      title={post.data.title}
      description={post.data.description}
    />

    <p class="mt-6 text-sm">
      <time datetime={post.data.pubDate.toISOString()}>
        {t("blog.publishedOn")} {formatDate(post.data.pubDate, lang)}
      </time>
      {post.data.updatedDate && (
        <span class="ms-3">
          {t("blog.updatedOn")} {formatDate(post.data.updatedDate, lang)}
        </span>
      )}
      {post.data.draft && <span class="chip ms-2">{t("blog.draft")}</span>}
    </p>

    {post.data.tags.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="chip">{tag}</span>
        ))}
      </p>
    )}

    <div class="article mt-8">
      <Content />
    </div>

    <p class="mt-12">
      <a href={localizePath("/blog", lang)} class="link-ink">
        {t("blog.backToBlog")}
      </a>
    </p>
  </article>
</BaseLayout>
