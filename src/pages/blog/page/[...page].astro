---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import TitleCard from "../../../components/TitleCard.astro";
import { getPosts, pageCount, pageSlice } from "../../../lib/posts";
import { useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getPosts("vi");
  const lastPage = pageCount(posts.length);

  return Array.from({ length: lastPage - 1 }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: { posts: pageSlice(posts, currentPage), currentPage, lastPage },
    };
  });
}

const { posts, currentPage, lastPage } = Astro.props;
const lang = "vi" as const;
const t = useTranslations(lang);
---

<BaseLayout title={t("blog.title")} description={t("blog.description")}>
  <TitleCard
    eyebrow={t("nav.blog")}
    title={t("blog.title")}
    description={t("blog.description")}
  />

  <div class="mt-8 grid gap-5">
    {posts.map((post) => (
      <PostCard post={post} lang={lang} />
    ))}
  </div>

  <Pagination currentPage={currentPage} lastPage={lastPage} lang={lang} />
</BaseLayout>
