---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { DARK_THEME } from "../lib/theme";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<label
  class="swap swap-rotate btn btn-ghost btn-circle"
  title={t("theme.toggle")}
>
  <input
    id="theme-toggle"
    type="checkbox"
    class="theme-controller"
    value={DARK_THEME}
    aria-label={t("theme.toggle")}
  />
  {/* Adapted from Phosphor Icons (MIT), the sun and moon used by the site
       before the Astro rewrite. */}
  <svg
    class="swap-off size-5"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 256 256"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M116 32V16a12 12 0 0 1 24 0v16a12 12 0 0 1-24 0m80 96a68 68 0 1 1-68-68a68.07 68.07 0 0 1 68 68m-24 0a44 44 0 1 0-44 44a44.05 44.05 0 0 0 44-44M51.51 68.49a12 12 0 1 0 17-17l-12-12a12 12 0 0 0-17 17Zm0 119l-12 12a12 12 0 0 0 17 17l12-12a12 12 0 1 0-17-17M196 72a12 12 0 0 0 8.49-3.51l12-12a12 12 0 0 0-17-17l-12 12A12 12 0 0 0 196 72m8.49 115.51a12 12 0 0 0-17 17l12 12a12 12 0 0 0 17-17ZM44 128a12 12 0 0 0-12-12H16a12 12 0 0 0 0 24h16a12 12 0 0 0 12-12m84 84a12 12 0 0 0-12 12v16a12 12 0 0 0 24 0v-16a12 12 0 0 0-12-12m112-96h-16a12 12 0 0 0 0 24h16a12 12 0 0 0 0-24"
    ></path>
  </svg>
  <svg
    class="swap-on size-5"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 256 256"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M236.37 139.4a12 12 0 0 0-12-3A84.07 84.07 0 0 1 119.6 31.59a12 12 0 0 0-15-15a108.86 108.86 0 0 0-54.91 38.48A108 108 0 0 0 136 228a107.09 107.09 0 0 0 64.93-21.69a108.86 108.86 0 0 0 38.44-54.94a12 12 0 0 0-3-11.97m-49.88 47.74A84 84 0 0 1 68.86 69.51a84.93 84.93 0 0 1 23.41-21.22Q92 52.13 92 56a108.12 108.12 0 0 0 108 108q3.87 0 7.71-.27a84.79 84.79 0 0 1-21.22 23.41"
    ></path>
  </svg>
</label>

<script is:inline define:vars={{ darkTheme: DARK_THEME }}>
  (function () {
    const input = document.getElementById("theme-toggle");
    if (!input) return;
    try {
      if (localStorage.getItem("theme") === darkTheme) input.checked = true;
    } catch {}
  })();
</script>

<script>
  import { themeForToggle } from "../lib/theme";

  const input = document.getElementById(
    "theme-toggle",
  ) as HTMLInputElement | null;
  input?.addEventListener("change", () => {
    const theme = themeForToggle(input.checked);
    document.documentElement.setAttribute("data-theme", theme);
    try {
      localStorage.setItem("theme", theme);
    } catch {}
  });
</script>
