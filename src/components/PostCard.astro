---
import {
  formatDate,
  localizePath,
  useTranslations,
  type Lang,
} from "../i18n/utils";
import { postSlug, type Post } from "../lib/posts";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const href = localizePath(`/blog/${postSlug(post)}`, lang);
---

<article class="contour-card animate-in">
  <div class="p-5">
    <h2 class="text-xl font-bold leading-tight">
      <a href={href} class="card-link">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-wider uppercase">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate, lang)}
      </time>
      {post.data.draft && <span class="chip">{t("blog.draft")}</span>}
    </p>
    <p class="mt-3">{post.data.description}</p>
    <p class="mt-4 flex justify-end">
      <a href={href} class="contour-btn">
        {t("blog.readMore")}
      </a>
    </p>
  </div>
</article>
