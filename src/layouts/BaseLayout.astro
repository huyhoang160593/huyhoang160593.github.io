---
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/utils";
import { DEFAULT_THEME, THEMES } from "../lib/theme";

interface Props {
  title: string;
  description: string;
  /** Path of this page in the other locale, when the URL shape differs (a post). */
  alternate?: string;
}

const { title, description, alternate } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === t("site.name") ? title : `${title} · ${t("site.name")}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t("site.name")} · ${t("blog.title")}`}
      href={localizePath("/rss.xml", lang)}
    />
    <meta name="generator" content={Astro.generator} />
    {/* Runs before the first paint so a chosen theme is applied without a
         flash. The theme names come from `../lib/theme`; `define:vars` on an
         `is:inline` script inlines them here, because this script must not be
         deferred or bundled. An absent or unrecognised saved value falls back
         to the default. */}
    <script
      is:inline
      define:vars={{ defaultTheme: DEFAULT_THEME, themes: THEMES }}
    >
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          const theme = themes.indexOf(saved) === -1 ? defaultTheme : saved;
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content">
    <header class="border-b border-base-300">
      <nav class="navbar mx-auto w-full max-w-3xl px-4">
        <div class="navbar-start">
          <a
            href={localizePath("/", lang)}
            class="btn btn-ghost px-2 text-lg font-semibold"
          >
            {t("site.name")}
          </a>
        </div>
        <div class="navbar-end gap-1">
          <a href={localizePath("/blog", lang)} class="btn btn-ghost btn-sm">
            {t("nav.blog")}
          </a>
          <LanguagePicker alternate={alternate} />
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl grow px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-base-300">
      <div class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-sm text-base-content/70">
        <p>
          © {year} {t("site.name")}
        </p>
        <p class="flex items-center gap-3">
          <a href={localizePath("/rss.xml", lang)} class="link link-hover">
            {t("blog.rss")}
          </a>
          <span>{t("footer.builtWith")}</span>
        </p>
      </div>
    </footer>
  </body>
</html>
