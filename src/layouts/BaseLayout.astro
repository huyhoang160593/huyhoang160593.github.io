---
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  getLangFromUrl,
  localizePath,
  stripLangPrefix,
  useTranslations,
} from "../i18n/utils";
import { DEFAULT_THEME, THEMES } from "../lib/theme";

interface Props {
  title: string;
  description: string;
  /** Path of this page in the other locale, when the URL shape differs (a post). */
  alternate?: string;
}

const { title, description, alternate } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === t("site.name") ? title : `${title} · ${t("site.name")}`;
const year = new Date().getFullYear();
// For the nav's wavy active underline: strip a trailing slash and the `/en`
// prefix, then ask whether this is the home or the blog section.
const barePath = stripLangPrefix(Astro.url.pathname.replace(/\/+$/, "") || "/");
const isHome = barePath === "/";
const isBlog = barePath === "/blog" || barePath.startsWith("/blog/");
const isAbout = barePath === "/about";
---

<!doctype html>
<html lang={lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t("site.name")} · ${t("blog.title")}`}
      href={localizePath("/rss.xml", lang)}
    />
    <meta name="generator" content={Astro.generator} />
    {/* Runs before the first paint so a chosen theme is applied without a
         flash. The theme names come from `../lib/theme`; `define:vars` on an
         `is:inline` script inlines them here, because this script must not be
         deferred or bundled. An absent or unrecognised saved value falls back
         to the default. */}
    <script
      is:inline
      define:vars={{ defaultTheme: DEFAULT_THEME, themes: THEMES }}
    >
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          const theme = themes.indexOf(saved) === -1 ? defaultTheme : saved;
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content">
    <header class="site-nav">
      <nav class="mx-auto flex w-full max-w-3xl items-center justify-between gap-3 px-4 py-3">
        <a
          href={localizePath("/", lang)}
          class="nav-link nav-mark"
          aria-current={isHome ? "page" : undefined}
        >
          {t("site.name")}
        </a>
        <div class="flex items-center gap-2">
          <a
            href={localizePath("/blog", lang)}
            class="nav-link text-sm font-semibold"
            aria-current={isBlog ? "page" : undefined}
          >
            {t("nav.blog")}
          </a>
          <a
            href={localizePath("/about", lang)}
            class="nav-link text-sm font-semibold"
            aria-current={isAbout ? "page" : undefined}
          >
            {t("nav.about")}
          </a>
          <LanguagePicker alternate={alternate} />
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl grow px-4 py-10">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-sm">
        <p>
          © {year} {t("site.name")}
        </p>
        <p class="flex items-center gap-3">
          <a href={localizePath("/rss.xml", lang)} class="link-ink">
            {t("blog.rss")}
          </a>
          <span>{t("footer.builtWith")}</span>
        </p>
      </div>
    </footer>
  </body>
</html>
